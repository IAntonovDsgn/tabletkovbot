{
  "name": "tabletkovbot/tabletkovbot",
  "type": "project",
  "require": {
    "php": "^8.4",
    "php-di/php-di": "^7.0",
    "doctrine/dbal": "^3.8",
    "irazasyed/telegram-bot-sdk": "^3.6",
    "vlucas/phpdotenv": "^5.5",
    "monolog/monolog": "^3.10",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "guzzlehttp/guzzle": "^7.13",
    "zircote/swagger-php": "^6.5",
    "nikic/fast-route": "^1.3",
    "illuminate/container": "^13.23",
    "ext-pdo": "*",
    "doctrine/migrations": "^3.9",
    "php-amqplib/php-amqplib": "^3.7"
  },
  "require-dev": {
    "pestphp/pest": "^4.7",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "console": "php src/Presentation/Console/Console.php"
  }
}
