{
  "name": "tabletkovbot/tabletkovbot",
  "type": "project",
  "require": {
    "php": "^8.4",
    "php-di/php-di": "^7.0",
    "doctrine/dbal": "^3.8",
    "irazasyed/telegram-bot-sdk": "^3.6",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "pestphp/pest": "^4.7",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest"
  }
}
